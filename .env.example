# ==============================================================================
# SmartCampus AI – Variables d'environnement
# ==============================================================================

# ---- Environnement ("dev", "test", "production") ----
# En production : l'application refuse strictement de démarrer si les secrets par défaut sont présents.
ENVIRONMENT=dev

# ---- Base de données PostgreSQL locale (port 5433 natif, hors Docker) ----
# Note: connect_timeout évite un blocage silencieux si le service PostgreSQL est arrêté.
DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@127.0.0.1:5433/smartcampus?connect_timeout=5

# ---- Paramètres de pool SQLAlchemy (recommandés en production) ----
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- Sécurité & JWT ----
# Générer un secret aléatoire fort (>= 32 caractères) :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# ---- Cycle de vie des sessions visiteurs ----
SESSION_TTL_HOURS=24
SESSION_MAX_TTL_DAYS=30

# ---- Compte administrateur par défaut ----
# En production, ADMIN_PASSWORD doit faire au moins 12 caractères et différer de la valeur par défaut.
ADMIN_EMAIL=admin@smartcampus.tn
ADMIN_PASSWORD=ChangeMe123!

# ---- Anti brute-force & Rate Limiting ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_IP_MAX_ATTEMPTS=25
REGISTER_IP_MAX_ATTEMPTS=10
REGISTER_WINDOW_SECONDS=900

# ---- Redis (optionnel en dev, recommandé en prod pour rate limiting distribué) ----
# REDIS_URL=redis://127.0.0.1:6379/0

# ---- Proxies de confiance pour la résolution sécurisée des IP clientes (ex: Nginx) ----
TRUSTED_PROXIES=["127.0.0.1", "::1"]

# ---- CORS (Origines autorisées, JSON array) ----
# En production : pas de wildcard '*', spécifiez les domaines réels de votre frontend.
CORS_ORIGINS=["http://localhost:3000"]

# ---- LLM Local Ollama (Modèle Gemma) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=1024
# OLLAMA_API_KEY=votre_cle_si_proxy_ollama
# LLM_SERVICE_API_KEY=cle_securisee_pour_proteger_api_backend_llm
LLM_FALLBACK_ENABLED=true
